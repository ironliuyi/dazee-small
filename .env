# ============================================================
# ZenFlux Agent - Docker Compose 环境变量
# ============================================================
# 计算巢「用户部署参数」会在部署时动态替换这些值。

# ==================== 必填 ====================

# 通义千问 API Key（主 Agent + 框架内部调用）
DASHSCOPE_API_KEY=

# ==================== 可选 LLM ====================

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
ZHIPUAI_API_KEY=
ZHIPUAI_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=

# ==================== 搜索/工具 ====================

TAVILY_API_KEY=
EXA_API_KEY=

# ==================== 应用配置 ====================

AGENT_INSTANCE=xiaodazi
AGENT_PROVIDER=qwen
LOG_LEVEL=INFO
APP_PORT=80
